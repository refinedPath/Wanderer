APP_DEBUG=true

DB_HOST=localhost
DB_PORT=5432
# DB_NAME must end with "_test". As a safeguard, test suite refuses to run unless DB_NAME ends in _test.
DB_NAME=mapapp_test
DB_USER=changeme
DB_PASS=changeme

# do this:
# php -r "echo bin2hex(random_bytes(64)), PHP_EOL;"
# and paste in JWT_SECRET=<paste_here>
JWT_SECRET=

# access token lifetime in seconds (default 900 = 15m)
JWT_TTL_SECONDS=900

# password policy                                                         
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=true

# DEV/DEMO ONLY - create new accounts already verified, skipping email verification.
# NEVER set true in production.
AUTO_VERIFY_NEW_ACCOUNTS=false

# mail transport: log (dev, writes to log) | memory (tests) | smtp (not implemented)
MAIL_TRANSPORT=memory

# base URL used to build links in emails (verification, etc.)
APP_URL=http://localhost

# hours a verification link stays valid
VERIFICATION_TTL_HOURS=1
